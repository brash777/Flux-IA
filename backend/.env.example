# =====================================================================
# Plantilla de variables de entorno de Flux IA.
#
# Copiala a .env y rellena los valores:   cp .env.example .env
# El archivo .env esta en .gitignore y NUNCA se sube al repositorio.
# =====================================================================

# --- Base de datos ---------------------------------------------------
# Este archivo lo lee Spring Boot solo, al arrancar. No hace falta
# ejecutar "source .env".
#
# Supabase, conexion directa (Project Settings > Database):
#   DB_URL=jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres?sslmode=require
#   DB_USERNAME=postgres
# Atencion: ese host solo tiene IPv6. En una red sin IPv6 falla con
# UnknownHostException; ahi hay que usar el pooler, que si tiene IPv4:
#   DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
#   DB_USERNAME=postgres.<project-ref>
# Siempre puerto 5432, nunca 6543: el modo por transaccion rompe los
# bloqueos de sesion que necesita Flyway.
#
# PostgreSQL local:
#   DB_URL=jdbc:postgresql://localhost:5432/fluxia
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# --- Firma de los JWT ------------------------------------------------
# Minimo 32 bytes. Genera uno nuevo asi:
#   openssl rand -base64 48
# Si cambias este valor, todas las sesiones abiertas se invalidan.
JWT_SECRET=

# --- Modelo de IA ----------------------------------------------------
# Proveedor del asistente:
#   groq       gratis, sin tarjeta. Clave en https://console.groq.com/keys
#   gemini     gratis, sin tarjeta. Clave en https://aistudio.google.com/apikey
#              (en el plan gratuito Google puede usar las conversaciones
#              para mejorar sus productos: sirve para la demo, no para
#              datos reales)
#   anthropic  de pago. Clave en https://console.anthropic.com
#   openai     cualquier otra API compatible con OpenAI: exige AI_BASE_URL
#              y AI_MODEL
# La clave vive SOLO en el servidor. Jamas se expone al frontend.
AI_PROVIDER=groq
AI_API_KEY=
# Opcionales: el modelo principal y los de respaldo, separados por coma.
# Vacios, se usan los del proveedor (Groq: openai/gpt-oss-120b y, si se
# queda sin cuota, openai/gpt-oss-20b).
AI_MODEL=
AI_FALLBACK_MODELS=
# Con AI_ENABLED=false el endpoint de chat responde 503 en lugar de
# llamar al modelo. Util para desarrollar sin clave.
AI_ENABLED=true

# --- Origenes permitidos (CORS) --------------------------------------
# URL del frontend. Varias separadas por coma, sin "*": un comodin
# permitiria llamar a la API desde cualquier sitio web.
# Live Server sirve el frontend en el 5500; se listan las dos formas de
# escribir localhost porque para el navegador son origenes distintos.
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# --- Puerto del servidor ---------------------------------------------
PORT=8080
