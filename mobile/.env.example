# Dirección del backend que la app usa la primera vez que se abre.
# Es opcional: si se deja vacía, la app la pide en pantalla. Copia este
# archivo como .env para usarla con «npm start».
#
# Si el backend corre en tu computador, es su IP en la red Wi-Fi y el
# puerto del servidor (el PORT de backend/.env, 8080 por omisión):
#   macOS:   ipconfig getifaddr en0
#   Windows: ipconfig
EXPO_PUBLIC_SERVER_URL=
