# =====================================================================
# Plantilla de variables de entorno de Flux IA.
#
# Copiala a .env y rellena los valores:   cp .env.example .env
# El archivo .env esta en .gitignore y NUNCA se sube al repositorio.
# =====================================================================

# --- Base de datos ---------------------------------------------------
# Este archivo lo lee Spring Boot solo, al arrancar. No hace falta
# ejecutar "source .env".
#
# Supabase, conexion directa (Project Settings > Database):
#   DB_URL=jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres?sslmode=require
#   DB_USERNAME=postgres
# Atencion: ese host solo tiene IPv6. En una red sin IPv6 falla con
# UnknownHostException; ahi hay que usar el pooler, que si tiene IPv4:
#   DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
#   DB_USERNAME=postgres.<project-ref>
# Siempre puerto 5432, nunca 6543: el modo por transaccion rompe los
# bloqueos de sesion que necesita Flyway.
#
# PostgreSQL local:
#   DB_URL=jdbc:postgresql://localhost:5432/fluxia
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# --- Firma de los JWT ------------------------------------------------
# Minimo 32 bytes. Genera uno nuevo asi:
#   openssl rand -base64 48
# Si cambias este valor, todas las sesiones abiertas se invalidan.
JWT_SECRET=

# --- Modelo de IA ----------------------------------------------------
# Se obtiene en https://console.anthropic.com -> API Keys
# Esta clave vive SOLO en el servidor. Jamas se expone al frontend.
ANTHROPIC_API_KEY=
# Con AI_ENABLED=false el endpoint de chat responde 503 en lugar de
# llamar al modelo. Util para desarrollar sin gastar credito.
AI_ENABLED=true

# --- Origenes permitidos (CORS) --------------------------------------
# URL del frontend. Varias separadas por coma.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Puerto del servidor ---------------------------------------------
PORT=8080
